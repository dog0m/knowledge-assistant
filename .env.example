# 复制此文件为 .env 并填入真实值。切勿把 .env 提交到版本库。

# ---------- PostgreSQL ----------
POSTGRES_DB=myapp
POSTGRES_USER=myappuser
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password

# ---------- 网络端口 ----------
# 宿主机访问管理界面的端口：http://localhost:8080
APP_PORT=8080
# RAG 服务只在容器内网暴露，不建议映射到宿主机
RAG_PORT=8090
OLLAMA_PORT=11434

# ---------- 服务间地址（Compose 内部 DNS） ----------
QDRANT_URL=http://qdrant:6333
RAG_BASE_URL=http://rag:8090

# ---------- 管理员初始账号 ----------
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_strong_random_password

# ---------- 向量库 ----------
QDRANT_COLLECTION=knowledge_chunks

# ---------- Embedding ----------
# 推荐先执行：docker exec myapp-ollama ollama pull bge-m3
OLLAMA_EMBED_MODEL=bge-m3

# ---------- 切分与检索 ----------
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_CHUNK_STRATEGY=fixed
RAG_RETRIEVAL_MODE=hybrid
RAG_MIN_SCORE=0.25
RAG_RERANK_LIMIT=20
RAG_MAX_RETRIES=3
# 真实 cross-encoder 重排默认关闭，避免首次运行自动下载模型
RAG_ENABLE_CROSS_ENCODER=false

# ---------- Agent ----------
AGENT_MAX_TOOL_CALLS=3

# ---------- 模型后端：ollama 或 openai ----------
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI 官方或兼容 OpenAI 协议的服务
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=CHANGE_ME

# ---------- 内部服务鉴权 ----------
# app 与 RAG 之间的共享令牌，必填且必须保密
# 生成（bash）：openssl rand -base64 48
# 生成（PowerShell）：[Convert]::ToBase64String((1..48|%{[byte](Get-Random -Max 256)}))
INTERNAL_API_KEY=CHANGE_ME_strong_random_key
